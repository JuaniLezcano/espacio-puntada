# Copiar a .env y ajustar si hace falta.
# Desarrollo local (Postgres levantado con `docker compose up -d`):
DATABASE_URL="postgresql://espacio_puntada:espacio_puntada@localhost:5432/espacio_puntada?schema=public"

# En Railway no hace falta setear esto a mano: el plugin de Postgres la
# inyecta como variable de referencia (ej. ${{Postgres.DATABASE_URL}}).

# Contraseña para /admin/reservas (HTTP Basic Auth, cualquier usuario sirve).
# En Railway sí hay que configurarla a mano por servicio, con un valor
# distinto al de local.
ADMIN_PASSWORD="cambiar-esto"
